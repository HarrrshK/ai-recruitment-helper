# ==========================================
# HR Recruitment AI System - .gitignore
# ==========================================

# --- Environment & Secret Files (NEVER COMMIT) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
!.env.local.example

# --- Python Virtual Environments ---
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/

# --- Python Cache & Testing Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Runtime Data, DB & Model Cache ---
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/hr.db*
backend/data/llm_cache/
backend/data/chroma/
backend/data/uploads/
backend/data/models/
backend/data/.jwt_secret

# --- Node.js & Frontend Build Outputs ---
node_modules/
frontend/node_modules/
frontend/.next/
frontend/.next-auth-check/
frontend/out/
frontend/build/
frontend/dist/
.vercel
.netlify

# --- Logs & Debug Output ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/dev.log
frontend/test-results/
playwright-report/
test-results/

# --- Operating System & Editor Temp Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
